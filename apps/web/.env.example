# Copy to .env.local. Only public values belong here: everything is shipped to the browser.

# Python resolver (resolver-py)
VITE_API_URL=http://localhost:8000

# Registry contract, read directly over NEAR RPC and written through the owner's wallet
VITE_CONTRACT_ID=unam-registry.testnet
VITE_NEAR_NETWORK=testnet
VITE_NEAR_RPC_URL=https://rpc.testnet.near.org
VITE_NAME_SUFFIX=.uni
