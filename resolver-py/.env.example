# SECRETS
# Deterministic dev seed (32 bytes hex) for local/testnet only.
# Mainnet rejects this seed and requires a freshly generated 32-byte hex secret.
RESOLVER_SIGNING_SEED_HEX="756e6976657273616c2d6e616d652d6861636b6174686f6e2d323032362d6b79"
AURORA_API_KEY=""
ONECLICK_API_KEY=""

# FEE PARAMETERS
FEE_INTEGRATOR_SHARE_PCT="60"
FEE_AURORA_SHARE_PCT="40"
FEE_STABLECOIN_FLOOR_BPS="2"
FEE_OTHER_TOKEN_FLOOR_BPS="10"
FEE_MAX_CAP_BPS="500"

# SWEEP LIMITS
CS_SWEEP_MAX_USD_PER_NAME="5000.0"
CS_MIN_ATTACHED_DEPOSIT_YOCTO="1"
CS_MAX_ATTACHED_DEPOSIT_NEAR="0.65"

# CONTRACT & NETWORK SETTINGS
# Leave NEAR_RPC_URL, MPC_SIGNER_CONTRACT_ID, and CS_WATCHER_ACCOUNT_ID blank to auto-select based on NEAR_NETWORK.
# On mainnet: set NEAR_NETWORK="mainnet", REGISTRY_CONTRACT_ID="<deployed-contract.near>",
# ALLOW_DEMO_ENDPOINTS="false", and PROOF_VERIFICATION_MODE="strict".
NEAR_NETWORK="testnet"
REGISTRY_CONTRACT_ID="unam-registry.testnet"
NEAR_RPC_URL=""
MPC_SIGNER_CONTRACT_ID=""
CS_WATCHER_ACCOUNT_ID=""
USE_MOCK_CONTRACT="false"
ALLOW_DEMO_ENDPOINTS="true"
PROOF_VERIFICATION_MODE="permissive"

# NEAR ADMIN CREDENTIALS & OPTIONAL AUTH
ADMIN_PUBLIC_KEY=""
ADMIN_PRIVATE_KEY=""
ADMIN_API_TOKEN=""
EVM_RPC_URLS_JSON="{}"